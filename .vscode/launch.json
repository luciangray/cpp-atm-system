{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ATM - GDB Source Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/atm_console",
            "args": [
                "--data",
                "${workspaceFolder}/build/debug-session/accounts.txt"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "TERM",
                    "value": "dumb"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "ATM: 编译项目"
        }
    ]
}
