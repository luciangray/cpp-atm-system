{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ATM: 配置项目",
            "type": "process",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build", "-DCMAKE_BUILD_TYPE=Debug", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
            "problemMatcher": []
        },
        {
            "label": "ATM: 编译项目",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "-j", "4"],
            "dependsOn": "ATM: 配置项目",
            "problemMatcher": ["$gcc"],
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "ATM: 运行图形界面",
            "type": "process",
            "command": "${workspaceFolder}/build/atm_gui",
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "ATM: 编译项目",
            "problemMatcher": []
        },
        {
            "label": "ATM: 运行控制台",
            "type": "process",
            "command": "${workspaceFolder}/build/atm_console",
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "ATM: 编译项目",
            "presentation": {"reveal": "always", "focus": true},
            "problemMatcher": []
        },
        {
            "label": "ATM: 运行测试",
            "type": "process",
            "command": "ctest",
            "args": ["--test-dir", "${workspaceFolder}/build", "--output-on-failure"],
            "dependsOn": "ATM: 编译项目",
            "problemMatcher": []
        }
    ]
}
